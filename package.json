{
  "name": "bq-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo pour la collection d'applications personnelles bq-*",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bank": "npm run dev -w bq-bank",
    "dev:car": "npm run dev -w bq-car",
    "dev:cloth": "npm run dev -w bq-cloth",
    "dev:coach": "npm run dev -w bq-coach",
    "dev:cook": "npm run dev -w bq-cook",
    "dev:graph": "npm run dev -w bq-graph",
    "dev:health": "npm run dev -w bq-health",
    "dev:learn": "npm run dev -w bq-learn",
    "dev:play": "npm run dev -w bq-play",
    "dev:watch": "npm run dev -w bq-watch",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
